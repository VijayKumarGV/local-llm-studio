{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["studio", "rag"],
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Studio · RAG",
  "uid": "studio-rag",
  "panels": [
    {
      "type": "timeseries",
      "title": "Retrieval latency (p50/p95/p99)",
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(studio_retrieval_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(studio_retrieval_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(studio_retrieval_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "type": "timeseries",
      "title": "Retrieval throughput (queries/s)",
      "targets": [{"expr": "sum(rate(studio_retrieval_latency_seconds_count[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "type": "heatmap",
      "title": "Retrieval hit-count distribution",
      "targets": [{"expr": "sum(rate(studio_retrieval_hits_bucket[5m])) by (le)", "format": "heatmap", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "type": "stat",
      "title": "Empty-hit rate (5m)",
      "targets": [{"expr": "rate(studio_retrieval_hits_bucket{le=\"0\"}[5m]) / clamp_min(rate(studio_retrieval_hits_count[5m]), 1e-9)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.15}]}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    }
  ]
}
